#import "/prelude.typ": *

#Recipe(title: "Mexican Rice")[
  - 325g white rice, long grain #pause[350mL]
  - 70mℓ cooking oil #pause[#missing[weight]]
  - 675mL water
  - 300g tomato, puréed #pause[2 tomatoes]
  - 1 carrot, diced #aside(missing[weight])
  - 1-3 jalapeños #aside[optional]
  - 50g onion, diced #aside[1/4 medium]
  - 5g garlic, minced #aside[5mL]
  - 9g tomato bouillon #aside[10mL]
  - 2g salt #aside[1.5mL]
][
  + PREHEAT oil in large saucepan, medium-high heat.
  + WASH rice in fine-mesh strainer till water runs clear.
  + COOK rice, stirring frequently, until rice is golden-brown. #pause[\~10 min.]
  + STIR all other ingredients into rice.
  + BOIL.
  + SIMMER covered, until water is completely absorbed by rice. #pause[\~20 min.]
  + REMOVE from heat.
  + REST. #pause[5 min.]
  + MIX gently with fork.
]
