#import "/prelude.typ": *

#Recipe(title: "Potato Slices", panel-width: 14.75em, yield: "~36 thin wedges")[
  - 450g potatoes, sliced #aside[3 medium]

  Sauce:
  - 42g butter, molten #aside[45mL]
  - 6g chicken bouillon #aside[5mL]
