#import "/formatting.typ": *

#recipe(
  title: "Sourdough Flatbread",
  description: [Easy way to use up some starter.],
  yield: "8",
)[
  Dough:
  - 240g all-purpose flour #aside[2 cups]
  - 60g einkorn flour #aside[1/2 cup]
  - 120g levain #aside[1/2 cup]
  - 55g Greek yogurt #aside[1/4 cup]
  - 9g chicken bouillon #aside[1 1/2 tsp]
  - 12g baking powder #aside[1 tbsp]
  - 115g water, lukewarm #aside[1/2 cup]

  Sauce:
  - 30g butter #aside[2 tbsp]
  - 7.5g garlic, minced #aside[4 cloves]
][
  + COMBINE ingredients roughly in large bowl.
  + COVER. #pause[15 min.]
  + PREHEAT oven to 260°C. #aside[500°F]
  + KNEAD completely smooth.
  + DIVIDE into 8 equal pieces.
  + REST. #pause[5 min.]
  + FLATTEN into thin patties on baking sheet.
  + BAKE. #pause[5 min.]
  + FLIP patties and brush with sauce.
  + BAKE. #pause[3 min.]
  + COOL on wire racks.

  Best within 3 days. Do not refrigerate.
]
